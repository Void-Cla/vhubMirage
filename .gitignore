*.py[cod]
.bootstrap.lock
.sidecar.lock
.sidecar-token

# vhub_npcai — artefatos gerados em runtime (sobrevivem a restart, mas NÃO versionam)
# colchetes de [SCRIPTS] escapados (senão viram classe de caractere glob)
resources/\[SCRIPTS\]/vhub_npcai/sidecar/audio_cache/
resources/\[SCRIPTS\]/vhub_npcai/sidecar/logs/

# Variáveis de ambiente
.env
*.env

# Segredos locais do FXServer — NUNCA versionar (ver .example ao lado de cada um).
# SEC-001: identity.cfg carrega sv_licenseKey (segredo cripto; pepper de login deriva
# dela). DB-002: database.cfg carrega a connection string do MySQL.
config/local.cfg
config/identity.cfg
config/database.cfg

# db/default — RocksDB runtime do FXServer (CFG-002). Estado efêmero, não versiona.
# colchetes de [SCRIPTS] no npcai já escapados acima; aqui é caminho simples.
db/default/

# .mcp.json É RASTREADO de propósito (secret-free): comandos portáveis, sem token literal.
