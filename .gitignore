# FXServer
build/
cache/
# tools/ ignorado, MAS git ainda desce no dir (tools/* em vez de tools/) para
# permitir a excecao abaixo — versionar o pipeline handling-balancer (codigo +
# config + selo p/ gate de CI). O proprio tool .gitignore exclui out/.backups/report.
tools/*
!tools/handling-balancer/
!tools/test_tier_rules.lua
!tools/test_b64_roundtrip.lua
metas/

# Exemplos e bases de referência
exemplos de base/

# Logs
*.log
log.txt

# Histórico de CLI
.replxx_history

# Node (recursos com webpack/vite)
node_modules/
dist/

# Python local
.venv/
__pycache__/
*.py[cod]
.bootstrap.lock
.sidecar.lock
.sidecar-token

# vhub_npcai — artefatos gerados em runtime (sobrevivem a restart, mas NÃO versionam)
# colchetes de [SCRIPTS] escapados (senão viram classe de caractere glob)
resources/\[SCRIPTS\]/vhub_npcai/sidecar/audio_cache/
resources/\[SCRIPTS\]/vhub_npcai/sidecar/logs/

# Variáveis de ambiente
.env
*.env

# Segredos locais do FXServer
config/local.cfg

# MCP config (pode conter tokens de API)
.mcp.json
